---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);

// Count posts for each tag
const tagCounts = posts
  .flatMap((post) => post.data.tags || [])
  .reduce((acc, tag) => {
    const trimmed = tag.trim().toLowerCase();
    acc[trimmed] = (acc[trimmed] || 0) + 1;
    return acc;
  }, {} as Record<string, number>);

const tags = Object.keys(tagCounts).sort((a, b) => tagCounts[b] - tagCounts[a]);
---

<Layout title="Tags | park-gyutae" description="블로그 포스트들에 지정된 태그별 목록 분류 페이지입니다.">
  <section class="page-header">
    <h1 class="page-title">Tags</h1>
    <p class="page-subtitle">블로그 내 모든 글들의 키워드와 글 개수입니다. 클릭 시 태그 검색으로 연결됩니다.</p>
  </section>

  <section class="tags-section">
    <div class="tags-grid-page">
      {tags.map((tag) => (
        <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="tag-item-card">
          <span class="tag-name">#{tag}</span>
          <span class="tag-count">{tagCounts[tag]} posts</span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: clamp(2.5rem, 6vw, 5rem) 0 1.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 500;
    line-height: .98;
    letter-spacing: -.09em;
  }

  .page-subtitle {
    max-width: 620px;
    font-size: .98rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  /* Tags Grid */
  .tags-grid-page {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2rem;
  }

  @media (min-width: 640px) {
    .tags-grid-page {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 768px) {
    .tags-grid-page {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tag-item-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: 88px;
    padding: 1rem 0;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--border-color);
    text-align: left;
    transition: border-color var(--transition-speed) ease;
  }

  .tag-item-card:hover {
    border-color: var(--primary-color);
  }

  .tag-name {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-color);
    margin-bottom: 0.25rem;
    transition: color var(--transition-speed) ease;
  }

  .tag-item-card:hover .tag-name {
    color: var(--primary-color);
  }

  .tag-count {
    font: 500 .62rem var(--font-mono);
    color: var(--text-muted);
    font-weight: 500;
  }
</style>
