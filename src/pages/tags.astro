---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);

// Count posts for each tag
const tagCounts = posts
  .flatMap((post) => post.data.tags || [])
  .reduce((acc, tag) => {
    const trimmed = tag.trim().toLowerCase();
    acc[trimmed] = (acc[trimmed] || 0) + 1;
    return acc;
  }, {} as Record<string, number>);

const tags = Object.keys(tagCounts).sort((a, b) => tagCounts[b] - tagCounts[a]);
---

<Layout title="Tags | park-gyutae" description="블로그 포스트들에 지정된 태그별 목록 분류 페이지입니다.">
  <section class="page-header">
    <h1 class="page-title">Tags</h1>
    <p class="page-subtitle">블로그 내 모든 글들의 키워드와 글 개수입니다. 클릭 시 태그 검색으로 연결됩니다.</p>
  </section>

  <section class="tags-section">
    <ul class="tag-list">
      {tags.map((tag) => (
        <li><a href={`/blog?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
          <span class="tag-count">{tagCounts[tag]} posts</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .tag-list { display: grid; gap: .4rem; padding-left: 1.25rem; }
  .tag-count { margin-left: .65rem; color: var(--text-muted); font-size: .88rem; }
</style>
