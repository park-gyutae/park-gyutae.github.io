---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import { profile } from '../data/portfolio';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<Layout title="박규태 | 수학과 프로젝트" description={profile.description}>
  <section class="home-introduction" aria-labelledby="home-title">
    <div>
      <p class="home-affiliation">연세대학교 수학과</p>
      <h1 id="home-title">박규태</h1>
      <p class="home-lead">대수학과 정수론을 공부합니다. 현실의 문제를 수학으로 표현하고, 데이터와 코드로 가정을 확인합니다.</p>
      <div class="action-links">
        <a class="button-primary" href="/projects/">프로젝트 보기 <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/about/">소개 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <img src="/avatar.webp" alt="박규태" width="540" height="660" decoding="async" />
  </section>

  <section class="home-focus" aria-label="관심 분야">
    <p class="home-focus-label">관심 분야</p>
    <ul><li>대수학과 정수론</li><li>확률과 최적화</li><li>그래프 머신러닝</li></ul>
  </section>

  <section class="portfolio-section" aria-labelledby="projects-heading">
    <div class="section-heading"><h2 id="projects-heading">대표 프로젝트</h2><a class="text-link" href="/projects/">모든 프로젝트 <span aria-hidden="true">→</span></a></div>
    <ProjectFeature />
  </section>

  {recentPosts.length > 0 && (
    <section class="portfolio-section" aria-labelledby="writing-heading">
      <div class="section-heading"><h2 id="writing-heading">최근 글</h2><a class="text-link" href="/blog/">모든 글 <span aria-hidden="true">→</span></a></div>
      <div class="recent-posts">
        {recentPosts.map(post => <BlogPostCard post={post} />)}
      </div>
    </section>
  )}
</Layout>

<style>
  .home-introduction {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(190px, .47fr);
    align-items: center;
    gap: clamp(2rem, 8vw, 7rem);
    padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1.3rem, 5vw, 4.75rem);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    background: var(--accent-surface);
  }
  .home-affiliation { margin-bottom: .55rem; color: var(--primary-color); font-size: .88rem; font-weight: 700; }
  h1 { margin-bottom: 1.2rem; font-size: clamp(3.3rem, 8.5vw, 6.5rem); line-height: 1.04; letter-spacing: -.075em; }
  .home-lead { max-width: 36rem; margin-bottom: 1.75rem; color: var(--text-muted); font-size: clamp(.98rem, 1.65vw, 1.18rem); line-height: 1.8; word-break: keep-all; }
  .home-introduction img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: center 36%; border-radius: 14px; }
  .home-focus { margin-top: .8rem; border-top: 0; }
  .portfolio-section { padding: clamp(2.25rem, 5vw, 4.25rem) 0; border-top: 0; }
  .portfolio-section + .portfolio-section { border-top: 1px solid var(--border-color); }
  .recent-posts { display: grid; gap: .75rem; }
  @media (max-width: 640px) {
    .home-introduction { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .home-introduction img { max-width: 100%; aspect-ratio: 4 / 3; }
  }
</style>
