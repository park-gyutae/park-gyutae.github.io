---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import MileageResults from '../components/MileageResults.astro';
import { mileage, profile } from '../data/portfolio';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<Layout title="박규태 | 수학과 프로젝트" description={profile.description}>
  <section class="home-introduction" aria-labelledby="home-title">
    <div>
      <p class="home-affiliation">연세대학교 수학과</p>
      <h1 id="home-title">박규태</h1>
      <p class="home-lead">대수학과 정수론을 공부합니다. 현실의 문제를 수학으로 표현하고, 데이터와 코드로 가정을 확인합니다.</p>
      <div class="action-links">
        <a class="text-link" href="/projects/">프로젝트 보기</a>
        <a class="text-link" href="/about/">소개</a>
      </div>
    </div>
    <img src="/avatar.webp" alt="박규태" width="540" height="660" decoding="async" />
  </section>

  <section class="home-focus" aria-label="관심 분야">
    <p class="home-focus-label">관심 분야</p>
    <ul><li>대수학과 정수론</li><li>확률과 최적화</li><li>그래프 머신러닝</li></ul>
  </section>

  <section class="portfolio-section" aria-labelledby="projects-heading">
    <div class="section-heading"><h2 id="projects-heading">대표 프로젝트</h2><a class="text-link" href="/projects/">모든 프로젝트</a></div>
    <div class="selected-work">
      <div>
        <h3>Yonsei Mileage</h3>
        <p class="project-question">한정된 수강신청 마일리지를 원하는 과목에 어떻게 나눠야 할까? 예측 오차를 줄인 모델이 실제 배분 성과도 높였는지 검증했습니다.</p>
        <div class="action-links">
          <a href={mileage.href}>프로젝트 개요</a>
          <a href={mileage.article}>기술 글</a>
          <a href={mileage.github}>코드</a>
        </div>
      </div>
      <MileageResults />
    </div>
  </section>

  {recentPosts.length > 0 && (
    <section class="portfolio-section" aria-labelledby="writing-heading">
      <div class="section-heading"><h2 id="writing-heading">최근 글</h2><a class="text-link" href="/blog/">모든 글</a></div>
      <div class="recent-posts">
        {recentPosts.map(post => <BlogPostCard post={post} />)}
      </div>
    </section>
  )}
</Layout>

<style>
  .home-introduction { display: grid; grid-template-columns: minmax(0, 1fr) 148px; gap: 1.5rem; max-width: var(--article-width); align-items: start; }
  .home-introduction img { display: block; border-radius: 3px; }
  .home-affiliation { margin-bottom: .4rem; color: var(--text-muted); }
  .home-lead { max-width: 34rem; }
  .home-focus { max-width: var(--article-width); margin-top: 1.5rem; font-size: .92rem; }
  .home-focus-label { margin-bottom: .2rem; font-weight: 650; }
  .home-focus ul { display: flex; flex-wrap: wrap; gap: .15rem 1.35rem; list-style: none; padding: 0; margin: 0; color: var(--text-muted); }
  .portfolio-section { margin-top: 2rem; }
  .selected-work { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 1rem 2rem; }
  .selected-work > :global(.mileage-results) { margin-block: 0; }
  @media (max-width: 900px) { .selected-work { grid-template-columns: minmax(0, 1fr); } }
  .project-question { max-width: var(--article-width); margin-bottom: .4rem; }
  @media (max-width: 480px) {
    .home-introduction { grid-template-columns: minmax(0, 1fr) 82px; gap: .85rem; }
  }
</style>
