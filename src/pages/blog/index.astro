---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';

const posts = (await getCollection('blog', ({ data }) => {
	return data.draft !== true;
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groups = [
	{ title: 'Concept Notes', entries: posts.filter(post => post.data.category === 'Concept Notes') },
	{ title: '게시글', entries: posts.filter(post => !post.data.category) },
];

const tagAliases: Record<string, string[]> = {
	mathematics: ['수학'],
	statistics: ['통계', '통계학'],
	'machine-learning': ['machine learning', '머신러닝', '기계학습'],
	optimization: ['최적화'],
	'decision-making': ['decision making', '의사결정'],
};
const normalizeTag = (tag: string) => tag.trim().toLowerCase();
const allTags = [...new Set(posts.flatMap(post => post.data.tags.map(normalizeTag)))];

const searchableText = ({ data, body }: typeof posts[number]) => {
	const tags = data.tags.map(normalizeTag);
	const text = body
		.replace(/!?(?:\[([^\]]*)\])\([^)]*\)/g, '$1')
		.replace(/<[^>]*>/g, ' ');
	return [data.title, data.description, data.subtitle, data.category, text, ...tags, ...tags.flatMap(tag => tagAliases[tag] || [])]
		.join(' ').normalize('NFKC').toLowerCase();
};
---

<Layout title="글 | 박규태" description="수학과 통계를 실제 문제에 적용하고, 구현과 검증을 거치며 배운 점을 기록합니다.">
	<section class="page-header">
		<h1 class="page-title">글</h1>
		<p class="page-subtitle">문제를 정의하고, 만들고, 실제 결과를 확인하며 배운 것들.</p>
	</section>

	<!-- Posts Grid Section -->
	<section class="posts-section">
		{posts.length === 0 ? (
			<div class="no-posts">
				<p>등록된 포스트가 없습니다.</p>
			</div>
		) : (
			<>
				{groups.filter(({ entries }) => entries.length > 0).map(({ title, entries }) => (
					<section class="post-group">
						<h2>{title}</h2>
						<div class="posts-grid">
							{entries.map(post => (
								<div
									class="post-wrapper"
									data-search={searchableText(post)}
									data-tags={JSON.stringify(post.data.tags.map(normalizeTag))}
								>
									<BlogPostCard post={post} />
								</div>
							))}
						</div>
					</section>
				))}
				<div class="no-results hidden" id="no-results">
					<p>검색 결과와 일치하는 포스트가 없습니다.</p>
				</div>
			</>
		)}
	</section>
	{posts.length > 0 && (
	<details class="filter-section" id="post-filters" open={posts.length > 5}>
		<summary>검색 및 태그</summary>
		<div class="search-container">
			<svg aria-hidden="true" class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
			<input type="text" id="search-input" placeholder="제목, 본문 또는 태그 검색" aria-label="글 검색" />
		</div>

		{allTags.length > 0 && (
			<div class="tags-container">
				<button class="tag-filter-btn active" data-tag="" aria-pressed="true">전체</button>
				{allTags.map(tag => (
					<button class="tag-filter-btn" data-tag={tag} aria-pressed="false">#{tag}</button>
				))}
			</div>
		)}
		<p id="search-status" role="status" aria-live="polite"></p>
	</details>
	)}
</Layout>

<style>
  .filter-section { max-width: var(--article-width); margin-top: 1.25rem; }
  .filter-section summary { width: fit-content; cursor: pointer; color: var(--primary-color); }
  .filter-section summary ~ * { margin-top: .7rem; }
  .search-container { position: relative; }
  .search-icon { position: absolute; left: .7rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
  #search-input { width: 100%; min-height: 42px; padding: .35rem .65rem .35rem 2.35rem; border: 1px solid var(--text-muted); border-radius: 3px; color: var(--text-color); background: var(--bg-color); }
  .tags-container { display: flex; flex-wrap: wrap; gap: .2rem .8rem; }
  .tag-filter-btn { min-height: 32px; padding: .05rem 0; border: 0; background: transparent; color: var(--primary-color); font-size: .9rem; cursor: pointer; }
  .tag-filter-btn:is(.active, :hover) { text-decoration: underline; text-underline-offset: .2em; }
  .tag-filter-btn.active { font-weight: 700; }
  #search-status { color: var(--text-muted); font-size: .88rem; }
  .post-group + .post-group { margin-top: 2rem; }
  .post-group:not(:has(.post-wrapper:not(.hidden))) { display: none; }
  .posts-grid { display: grid; gap: 1.35rem; }
  .no-posts, .no-results { color: var(--text-muted); }
  .hidden { display: none !important; }
</style>

<script>
	const searchInput = document.querySelector<HTMLInputElement>('#search-input');
	const filters = document.querySelector<HTMLDetailsElement>('#post-filters');
	const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
	const posts = [...document.querySelectorAll<HTMLElement>('.post-wrapper')].map(element => ({
		element,
		text: element.dataset.search || '',
		tags: JSON.parse(element.dataset.tags || '[]') as string[],
	}));
	const noResults = document.getElementById('no-results');
	const status = document.getElementById('search-status');
	let currentTag = '';
	const filterPosts = () => {
		const terms = (searchInput?.value || '').normalize('NFKC').trim().toLowerCase().split(/\s+/).filter(Boolean);
		let count = 0;
		posts.forEach(({ element, text, tags }) => {
			const visible = terms.every(term => text.includes(term)) && (!currentTag || tags.includes(currentTag));
			element.classList.toggle('hidden', !visible);
			if (visible) count++;
		});
		noResults?.classList.toggle('hidden', count > 0);
		if (status) status.textContent = `${count}개의 글`;
		tagButtons.forEach(button => {
			const active = button.dataset.tag === currentTag;
			button.classList.toggle('active', active);
			button.setAttribute('aria-pressed', String(active));
		});
	};
	const restoreURL = () => {
		const params = new URLSearchParams(location.search);
		currentTag = (params.get('tag') || '').trim().toLowerCase();
		if (searchInput) searchInput.value = params.get('q') || '';
		if (filters && (currentTag || searchInput?.value)) filters.open = true;
		filterPosts();
	};
	const updateURL = (push: boolean) => {
		const url = new URL(location.href);
		if (currentTag) url.searchParams.set('tag', currentTag); else url.searchParams.delete('tag');
		const query = searchInput?.value.trim();
		if (query) url.searchParams.set('q', query); else url.searchParams.delete('q');
		if (url.href !== location.href) {
			if (push) history.pushState(null, '', url); else history.replaceState(null, '', url);
		}
		filterPosts();
	};
	searchInput?.addEventListener('input', () => updateURL(false));
	tagButtons.forEach(button => button.addEventListener('click', () => {
		currentTag = button.dataset.tag || '';
		updateURL(true);
	}));
	window.addEventListener('popstate', restoreURL);
	restoreURL();
</script>
