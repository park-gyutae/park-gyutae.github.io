---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';

const posts = (await getCollection('blog', ({ data }) => {
	return data.draft !== true;
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect all unique tags
const allTags = [...new Set(posts.flatMap(post => post.data.tags.map(tag => tag.trim().toLowerCase())))];
---

<Layout title="프로젝트 기록 | 박규태" description="수학과 통계를 실제 문제에 적용하고, 구현과 검증을 거치며 배운 점을 기록합니다.">
	<section class="page-header">
		<h1 class="page-title">프로젝트 기록</h1>
		<p class="page-subtitle">문제를 정의하고, 만들고, 실제 결과를 확인하며 배운 것들.</p>
	</section>

	<!-- Filter / Search Section -->
	<section class="filter-section">
		<div class="search-container">
			<svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
			<input type="text" id="search-input" placeholder="글 제목, 설명 또는 태그 검색..." aria-label="글 검색" />
		</div>

		{allTags.length > 0 && (
			<div class="tags-container">
				<button class="tag-filter-btn active" data-tag="" aria-pressed="true">전체</button>
				{allTags.map(tag => (
					<button class="tag-filter-btn" data-tag={tag} aria-pressed="false">#{tag}</button>
				))}
			</div>
		)}
	</section>

	<!-- Posts Grid Section -->
	<p id="search-status" role="status" aria-live="polite">{posts.length}개의 글</p>
	<section class="posts-section">
		{posts.length === 0 ? (
			<div class="no-posts">
				<p>등록된 포스트가 없습니다.</p>
			</div>
		) : (
			<div class="posts-grid" id="posts-grid">
				{posts.map((post) => (
					<div 
						class="post-wrapper" 
						data-title={post.data.title.toLowerCase()}
						data-description={post.data.description.toLowerCase()}
						data-tags={JSON.stringify(post.data.tags.map(t => t.trim().toLowerCase()))}
					>
						<BlogPostCard post={post} />
					</div>
				))}
			</div>
			<div class="no-results hidden" id="no-results">
				<p>검색 결과와 일치하는 포스트가 없습니다.</p>
			</div>
		)}
	</section>
</Layout>

<style>
	.page-header {
		padding: 2rem 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 2.5rem;
	}

	.page-title {
		font-size: 2.5rem;
		font-weight: 800;
	}

	.page-subtitle {
		font-size: 1.1rem;
		color: var(--text-muted);
	}

	/* Filter and Search Section */
	.filter-section {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.search-container {
		position: relative;
		width: 100%;
	}

	.search-icon {
		position: absolute;
		left: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-muted);
		pointer-events: none;
	}

	#search-input {
		width: 100%;
		padding: 1rem 1rem 1rem 3.25rem;
		font-size: 1.05rem;
		font-family: inherit;
		background-color: var(--card-bg);
		color: var(--text-color);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		box-shadow: var(--card-shadow);
		outline: none;
		transition: all var(--transition-speed) ease;
	}

	#search-input:focus {
		border-color: var(--primary-color);
		box-shadow: 0 0 0 3px rgba(0, 71, 171, 0.1);
	}

	.tags-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag-filter-btn {
		font-size: 0.9rem;
		font-weight: 600;
		padding: 0.4rem 1rem;
		border-radius: 0.5rem;
		border: 1px solid var(--border-color);
		background-color: var(--card-bg);
		color: var(--text-muted);
		cursor: pointer;
		transition: all var(--transition-speed) ease;
	}

	.tag-filter-btn:hover {
		background-color: var(--border-color);
		color: var(--text-color);
	}

	.tag-filter-btn.active {
		background-color: var(--primary-color);
		border-color: var(--primary-color);
		color: #ffffff;
		box-shadow: 0 4px 6px -1px rgba(0, 71, 171, 0.2);
	}

	/* Posts grid */
	.posts-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	@media (min-width: 640px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.no-posts, .no-results {
		text-align: center;
		padding: 4rem 0;
		color: var(--text-muted);
		font-size: 1.1rem;
		background-color: var(--card-bg);
		border: 1px dashed var(--border-color);
		border-radius: 0.75rem;
	}

	.hidden {
		display: none !important;
	}
</style>

<script>
	const searchInput = document.getElementById('search-input') as HTMLInputElement;
	const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
	const posts = [...document.querySelectorAll<HTMLElement>('.post-wrapper')].map(element => ({
		element,
		text: [element.dataset.title, element.dataset.description, ...(JSON.parse(element.dataset.tags || '[]') as string[])].join(' ').toLowerCase(),
		tags: JSON.parse(element.dataset.tags || '[]') as string[],
	}));
	const noResults = document.getElementById('no-results');
	const status = document.getElementById('search-status');
	let currentTag = '';
	const filterPosts = () => {
		const query = searchInput.value.trim().toLowerCase();
		let count = 0;
		posts.forEach(({ element, text, tags }) => {
			const visible = text.includes(query) && (!currentTag || tags.includes(currentTag));
			element.classList.toggle('hidden', !visible);
			if (visible) count++;
		});
		noResults?.classList.toggle('hidden', count > 0);
		if (status) status.textContent = `${count}개의 글`;
		tagButtons.forEach(button => {
			const active = button.dataset.tag === currentTag;
			button.classList.toggle('active', active);
			button.setAttribute('aria-pressed', String(active));
		});
	};
	const restoreURL = () => {
		const params = new URLSearchParams(location.search);
		currentTag = (params.get('tag') || '').trim().toLowerCase();
		searchInput.value = params.get('q') || '';
		filterPosts();
	};
	const updateURL = (push: boolean) => {
		const url = new URL(location.href);
		if (currentTag) url.searchParams.set('tag', currentTag); else url.searchParams.delete('tag');
		if (searchInput.value.trim()) url.searchParams.set('q', searchInput.value.trim()); else url.searchParams.delete('q');
		if (url.href !== location.href) {
			if (push) history.pushState(null, '', url); else history.replaceState(null, '', url);
		}
		filterPosts();
	};
	searchInput.addEventListener('input', () => updateURL(false));
	tagButtons.forEach(button => button.addEventListener('click', () => {
		currentTag = button.dataset.tag || '';
		updateURL(true);
	}));
	window.addEventListener('popstate', restoreURL);
	restoreURL();
</script>
