---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MileageResults from '../../components/MileageResults.astro';
import 'katex/dist/katex-swap.min.css';
import { profile, mileage } from '../../data/portfolio';

export async function getStaticPaths() {
	const posts = (await getCollection('blog', ({ data }) => !data.draft))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	
	return posts.map((post, index) => ({
		params: { slug: post.slug },
		props: {
			post,
			prev: index < posts.length - 1 ? posts[index + 1] : null,
			next: index > 0 ? posts[index - 1] : null,
		},
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	prev: CollectionEntry<'blog'> | null;
	next: CollectionEntry<'blog'> | null;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, subtitle, showHero, tocDepth, project } = post.data;
const { Content, headings } = await post.render();

const formattedDate = new Date(pubDate).toLocaleDateString('ko-KR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const formattedUpdatedDate = updatedDate ? new Date(updatedDate).toLocaleDateString('ko-KR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
}) : null;
const plainBody = post.body.replace(/<[^>]+>|[#>*_`$\[\]()-]/g, ' ');
const readingMinutes = Math.max(1, Math.ceil(plainBody.split(/\s+/).filter(Boolean).length / 350));
const isMileage = project === 'yonsei-mileage';
const titleFont = `https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@700&display=swap&text=${encodeURIComponent(title)}`;
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= tocDepth);
---

<Layout title={title} description={description} image={isMileage ? '/images/yonsei-mileage/figure-05-decision-utility-vs-oracle.png' : heroImage} isWide={true} article={{ published: pubDate, modified: updatedDate, tags }}>
	{isMileage && <link slot="head" rel="stylesheet" href={titleFont} />}
	<!-- Scroll Progress Bar -->
	<div id="scroll-progress" class="scroll-progress-bar"></div>
	<div id="reading-section-status" class="reading-section-status" aria-hidden="true"></div>

	<!-- Responsive 2-column post page layout container -->
	<div class="post-layout-container">
		<article class="post-article">
			<!-- Back Button & Meta -->
			<div class="article-navigation">
				<a href="/blog" class="back-link">목록으로 돌아가기</a>
			</div>

			<header class="article-header">
				<div class="article-meta" aria-label="글 정보">
					<time datetime={pubDate.toISOString()}>{formattedDate}</time>
					<span>읽는 시간 {readingMinutes}분</span>
					<span>{project === 'yonsei-mileage' ? '확률 · 최적화' : tags.slice(0, 2).join(' · ')}</span>
					{formattedUpdatedDate && (
						<span class="updated-date">
							수정 {formattedUpdatedDate}
						</span>
					)}
				</div>
				
				<h1 class:list={['article-title', { 'article-title-serif': isMileage }]}>{title}</h1>

				{project === 'yonsei-mileage' && (
					<p class="article-finding">2026-2 수강신청을 검증한 결과, 사전 모델은 과거 평균보다 예측 오차를 30.75% 줄였습니다. 하지만 886개 과목 조합을 재현한 실험에서 이 모델로 배분했을 때의 평균 확보 효용은 기존 배포 모델로 배분했을 때보다 낮았습니다.</p>
				)}

				{isMileage && <MileageResults />}

				<p class="article-desc">{subtitle || description}</p>

				{tags && tags.length > 0 && (
					<div class="article-tags">
						{tags.map((tag) => (
							<a href={`/blog?tag=${encodeURIComponent(tag.trim().toLowerCase())}`} class="tag-badge">#{tag}</a>
						))}
					</div>
				)}
			</header>

			{heroImage && showHero && (
				<div class="hero-image-container">
					<img src={heroImage} alt={title} class="hero-image" />
				</div>
			)}

			{project === 'yonsei-mileage' && <nav class="article-project-links action-links" aria-label="관련 프로젝트">
              <a class="text-link" href={mileage.href}>프로젝트 개요</a>
              <a class="text-link" href={mileage.demo} target="_blank" rel="noopener noreferrer">서비스</a>
              <a class="text-link" href={mileage.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            </nav>}
            <hr class="header-divider" />

			<!-- 1. Mobile-Only Inline Table of Contents (Visible only on mobile/tablet) -->
			{tocHeadings.length > 0 && (
				<details class="post-toc-inline" id="article-contents">
					<summary class="toc-title"><span>목차</span><small>{tocHeadings.length}개</small></summary>
					<ul class="toc-list">
						{tocHeadings.map((h) => (
							<li class={`toc-item depth-${h.depth}`}>
								<a href={`#${h.slug}`} class="toc-link">{h.text}</a>
							</li>
						))}
					</ul>
				</details>
			)}

			<!-- Main Markdown Content -->
			<div class="prose">
				<Content />
			</div>

			<hr class="footer-divider" />

			<!-- Author Bio Card -->
			<div class="author-card">
				<div class="author-avatar">
					<img src="/avatar.webp" alt="박규태" width="56" height="56" loading="lazy" decoding="async" />
				</div>
				<div class="author-info">
					<span class="author-label">Written by</span>
					<p class="author-name">박규태</p>
					<p class="author-bio">{profile.description}</p>
					<div class="author-socials">
						<a href="https://github.com/park-gyutae" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub Profile">
							<span>GitHub</span>
						</a>
					</div>
				</div>
			</div>

			<hr class="footer-divider" />

			<!-- Previous / Next post links -->
			<nav class="post-navigation">
				<div class="nav-prev">
					{prev && (
						<a href={`/blog/${prev.slug}`} class="nav-card">
							<span class="nav-label">이전 글</span>
							<span class="nav-title">{prev.data.title}</span>
						</a>
					)}
				</div>
				<div class="nav-next">
					{next && (
						<a href={`/blog/${next.slug}`} class="nav-card">
							<span class="nav-label">다음 글</span>
							<span class="nav-title">{next.data.title}</span>
						</a>
					)}
				</div>
			</nav>
		</article>

		<!-- 2. Desktop-Only Sticky Table of Contents (Visible only on Desktop >= 1024px) -->
		{tocHeadings.length > 0 && (
			<aside class="post-toc-sidebar" aria-label="글 목차">
				<div class="toc-sticky-container">
					<div class="toc-header"><div><p>목차</p><span>{tocHeadings.length}개</span></div></div>
					<div class="toc-progress-track" aria-hidden="true"><span id="toc-progress-fill"></span></div>
					<ul class="toc-list">
						{tocHeadings.map((h) => (
							<li class={`toc-item depth-${h.depth}`}>
								<a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>{h.text}</a>
							</li>
						))}
					</ul>
				</div>
			</aside>
		)}
	</div>

	{tocHeadings.length > 0 && <button id="return-to-contents" class="return-to-contents" type="button" hidden>목차로</button>}

	<!-- Scroll To Top Button -->
	<button id="scroll-to-top" class="scroll-to-top-btn" aria-label="맨 위로">
		<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<polyline points="18 15 12 9 6 15"></polyline>
		</svg>
	</button>

	<dialog id="image-lightbox" class="image-lightbox" aria-label="확대 이미지">
		<button class="lightbox-close" type="button" aria-label="확대 이미지 닫기">×</button>
		<img alt="" />
		<p></p>
	</dialog>
</Layout>

<style>
  .scroll-progress-bar { position: fixed; inset: 0 auto auto 0; z-index: 10; width: 0; height: 2px; background: var(--primary-color); }
  .reading-section-status { position: fixed; top: 2px; right: var(--gutter); z-index: 9; display: none; max-width: 40vw; padding: .2rem .5rem; overflow: hidden; color: var(--text-muted); background: var(--bg-color); font-size: .8rem; text-overflow: ellipsis; white-space: nowrap; }
  @media (min-width: 960px) { .reading-section-status.visible { display: block; } }
  .post-layout-container { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; align-items: start; }
  .post-article { width: 100%; max-width: var(--article-width); min-width: 0; margin-inline: auto; }
  .article-navigation { margin-bottom: 1.2rem; font-size: .9rem; }
  .article-meta, .article-tags { display: flex; flex-wrap: wrap; gap: .2rem .85rem; font-size: .85rem; }
  .article-meta { margin-bottom: .6rem; color: var(--text-muted); }
  .article-title { font-size: clamp(1.85rem, 3.6vw, 2.55rem); overflow-wrap: anywhere; }
  .article-title-serif { font-family: "Noto Serif KR", "Noto Serif CJK KR", Batang, serif; font-weight: 700; line-height: 1.38; letter-spacing: -.045em; word-break: keep-all; }
  .article-desc { color: var(--text-muted); }
  .article-project-links { margin: .85rem 0 0; }
  .hero-image { display: block; margin-top: 1rem; }
  .header-divider, .footer-divider { border: 0; border-top: 1px solid var(--border-color); margin: 1.45rem 0; }
  .post-toc-inline { margin-bottom: 1.3rem; }
  .toc-title { cursor: pointer; font-weight: 650; }
  .toc-title small { margin-left: .55rem; color: var(--text-muted); font-weight: normal; }
  .toc-list { margin: .4rem 0 0; padding: 0; list-style: none; }
  .toc-item.depth-3 { padding-left: .8rem; }
  .toc-link { display: block; padding: .15rem 0; color: var(--text-muted); font-size: .88rem; line-height: 1.45; text-decoration: none; }
  .toc-link:hover, .toc-link.active { color: var(--primary-color); text-decoration: underline; }
  .toc-link.active { font-weight: 650; }
  .post-toc-sidebar { display: none; }
  .toc-header { margin-bottom: .45rem; }
  .toc-header p { display: inline; font-weight: 650; }
  .toc-header span { color: var(--text-muted); font-size: .82rem; margin-left: .5rem; }
  .toc-progress-track { height: 2px; background: var(--border-color); }
  .toc-progress-track span { display: block; width: 0; height: 100%; background: var(--primary-color); }
  @media (min-width: 960px) {
    .post-layout-container { grid-template-columns: minmax(0, var(--article-width)) minmax(0, 1fr); }
    .post-toc-inline { display: none; }
    .post-toc-sidebar { display: block; position: sticky; top: 1.5rem; min-width: 0; }
    .toc-sticky-container { position: relative; max-height: calc(100vh - 3rem); overflow: auto; padding: .4rem .55rem .4rem .75rem; border-left: 1px solid var(--border-color); }
  }
  .author-card { display: flex; align-items: start; gap: .8rem; }
  .author-avatar { flex: 0 0 44px; }
  .author-avatar img { display: block; border-radius: 3px; }
  .author-label, .author-bio, .nav-label { color: var(--text-muted); font-size: .88rem; }
  .author-name { font-weight: 650; margin-bottom: .2rem; }
  .author-bio { margin-bottom: .3rem; }
  .post-navigation { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .nav-card { display: flex; flex-direction: column; }
  .scroll-to-top-btn { position: fixed; bottom: 1rem; right: 1rem; display: none; place-items: center; width: 44px; height: 44px; padding: .35rem; border: 1px solid var(--text-muted); border-radius: 4px; background: var(--bg-color); color: var(--primary-color); cursor: pointer; }
  .scroll-to-top-btn.visible { display: grid; }
  .return-to-contents { display: none; }
  @media (max-width: 959px) {
    .return-to-contents:not([hidden]) {
      position: fixed;
      bottom: 1rem;
      right: 4.25rem;
      z-index: 2;
      display: block;
      min-height: 44px;
      padding: .3rem .65rem;
      border: 1px solid var(--text-muted);
      border-radius: 4px;
      color: var(--primary-color);
      background: var(--bg-color);
      cursor: pointer;
    }
  }
  @media print { .return-to-contents { display: none !important; } }
  .image-lightbox { width: min(1080px, 100% - 2rem); max-height: calc(100vh - 2rem); padding: .8rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--bg-color); color: var(--text-color); }
  .image-lightbox::backdrop { background: rgb(0 0 0 / .65); }
  .image-lightbox img { display: block; max-height: 74vh; margin-inline: auto; object-fit: contain; }
  .image-lightbox p { margin: .65rem 0 0; color: var(--text-muted); font-size: .88rem; }
  .lightbox-close { display: block; width: 44px; height: 44px; margin: 0 0 .5rem auto; border: 1px solid var(--text-muted); border-radius: 3px; background: var(--bg-color); color: var(--text-color); cursor: pointer; }
  .prose :global(.mileage-example) { margin-block: 1.5rem; padding: .8rem 1rem; background: var(--card-bg); }
  .prose :global(.mileage-example figcaption) { margin: 0 0 .6rem; }
  .prose :global(.mileage-example output) { display: block; margin-block: .45rem; }
  .prose :global(.mileage-example select) { margin-left: .45rem; min-height: 44px; padding-inline: .35rem; font: inherit; color: var(--text-color); background: var(--bg-color); border: 1px solid var(--text-muted); border-radius: 3px; }
  .prose :global(.mileage-example-track) { display: block; height: .5rem; background: var(--border-color); }
  .prose :global(.mileage-example-track > span) { display: block; height: 100%; background: var(--primary-color); }
  .prose :global(.mileage-example p) { margin: .5rem 0 0; color: var(--text-muted); font-size: .84rem; }
</style>

<script>
	const mileageExample = document.querySelector('#mileage-example');
	const mileageSelect = mileageExample?.querySelector('select');
	const mileageOutput = mileageExample?.querySelector('output');
	const mileageBar = mileageExample?.querySelector<HTMLElement>('.mileage-example-track > span');
	const mileageControl = mileageExample?.querySelector<HTMLElement>('.mileage-control');

	if (mileageSelect && mileageOutput && mileageBar && mileageControl) {
		const updateMileage = () => {
			const selected = mileageSelect.options[mileageSelect.selectedIndex];
			const previous = mileageSelect.options[mileageSelect.selectedIndex - 1];
			const probability = Number(selected.value);
			const change = previous
				? ` ${previous.text}보다 ${(probability - Number(previous.value)).toFixed(2)}%p 높습니다.`
				: '';
			const value = document.createElement('strong');
			value.textContent = `${probability.toFixed(2)}%`;
			mileageOutput.replaceChildren(`${selected.text}에서 성공확률 `, value, '.', change);
			mileageBar.style.width = `${probability}%`;
		};
		mileageSelect.addEventListener('change', updateMileage);
		updateMileage();
		mileageControl.hidden = false;
	}

	const inlineContents = document.querySelector<HTMLDetailsElement>('#article-contents');
	const contentsButton = document.querySelector<HTMLButtonElement>('#return-to-contents');
	const scrollToTopBtn = document.getElementById('scroll-to-top');

	contentsButton?.addEventListener('click', () => {
		if (!inlineContents) return;
		inlineContents.open = true;
		inlineContents.querySelector('summary')?.focus({ preventScroll: true });
		inlineContents.scrollIntoView();
	});
	if (inlineContents && contentsButton) {
		const updateContentsButton = () => {
			contentsButton.hidden = inlineContents.getBoundingClientRect().bottom >= 0;
		};
		window.addEventListener('scroll', updateContentsButton, { passive: true });
		window.addEventListener('resize', updateContentsButton);
		updateContentsButton();
	}

	// Scroll progress indicator
	window.addEventListener('scroll', () => {
		const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
		const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
		const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
		
		const progressEl = document.getElementById('scroll-progress');
		if (progressEl) {
			progressEl.style.width = scrolled + '%';
		}
		const tocProgress = document.getElementById('toc-progress-fill');
		if (tocProgress) tocProgress.style.width = scrolled + '%';

		scrollToTopBtn?.classList.toggle('visible', winScroll > 300);
		if (readingStatus && winScroll <= 420) readingStatus.classList.remove('visible');
	});

	// Scroll to top action
	scrollToTopBtn?.addEventListener('click', () => {
		window.scrollTo({
			top: 0,
			behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
		});
	});

	// Active TOC Heading Tracking (Intersection Observer) - Desktop Only
	const headingElements = document.querySelectorAll('.prose h2, .prose h3');
	const tocLinks = document.querySelectorAll('.toc-link');
	const readingStatus = document.getElementById('reading-section-status');

	const copyText = async (text: string) => {
		try { await navigator.clipboard.writeText(text); return true; } catch { return false; }
	};

	// Copyable heading anchors
	headingElements.forEach((heading) => {
		if (!heading.id) return;
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'heading-anchor';
		button.setAttribute('aria-label', '이 섹션 링크 복사');
		button.textContent = '#';
		button.addEventListener('click', async () => {
			const url = `${location.origin}${location.pathname}#${heading.id}`;
			if (await copyText(url)) {
				button.textContent = '✓';
				setTimeout(() => { button.textContent = '#'; }, 1200);
			}
		});
		heading.append(button);
	});

	// Code language labels and copy controls
	document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
		const language = (pre.dataset.language || 'code').toUpperCase();
		const label = document.createElement('span');
		label.className = 'code-language';
		label.textContent = language;
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'code-copy';
		button.textContent = 'Copy';
		button.setAttribute('aria-label', `${language} 코드 복사`);
		button.addEventListener('click', async () => {
			const code = pre.querySelector('code')?.textContent || '';
			if (await copyText(code)) {
				button.textContent = 'Copied';
				setTimeout(() => { button.textContent = 'Copy'; }, 1400);
			}
		});
		pre.append(label, button);
	});

	// Linkable equation numbers
	document.querySelectorAll<HTMLElement>('.prose .katex-display').forEach((equation, index) => {
		equation.id = `equation-${index + 1}`;
		const anchor = document.createElement('a');
		anchor.className = 'equation-number';
		anchor.href = `#${equation.id}`;
		anchor.textContent = `EQ. ${String(index + 1).padStart(2, '0')}`;
		anchor.setAttribute('aria-label', `수식 ${index + 1} 링크`);
		equation.append(anchor);
	});

	// GitHub-style callouts plus editorial summaries.
	document.querySelectorAll<HTMLElement>('.prose blockquote').forEach((quote) => {
		const first = quote.querySelector('p');
		if (!first) return;
		const match = first.textContent?.trim().match(/^\[!(NOTE|SUMMARY|WARNING|THEOREM|DEFINITION|PROOF)\]/i);
		if (!match) return;
		const type = match[1].toLowerCase();
		quote.classList.add('callout', `callout-${type}`);
		first.innerHTML = first.innerHTML.replace(/^\[!(NOTE|SUMMARY|WARNING|THEOREM|DEFINITION|PROOF)\]\s*/i, '');
		quote.dataset.calloutLabel = type === 'summary' ? '중간 결론' : match[1];
	});

	// In-page image lightbox
	const lightbox = document.getElementById('image-lightbox') as HTMLDialogElement | null;
	const lightboxImage = lightbox?.querySelector('img');
	const lightboxCaption = lightbox?.querySelector('p');
	document.querySelectorAll<HTMLAnchorElement>('.article-figure > a').forEach((link) => {
		link.addEventListener('click', (event) => {
			if (event.metaKey || event.ctrlKey || event.shiftKey || !lightbox || !lightboxImage) return;
			event.preventDefault();
			const source = link.querySelector('img');
			lightboxImage.src = link.href;
			lightboxImage.alt = source?.alt || '';
			if (lightboxCaption) lightboxCaption.textContent = link.parentElement?.querySelector('figcaption')?.textContent || source?.alt || '';
			lightbox.showModal();
		});
	});
	lightbox?.querySelector('.lightbox-close')?.addEventListener('click', () => lightbox.close());
	lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });

	if (headingElements.length > 0 && tocLinks.length > 0) {
		const observerOptions = {
			root: null,
			rootMargin: '-100px 0px -70% 0px',
			threshold: 0.1
		};

		let currentActiveId = '';

		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					currentActiveId = entry.target.id;
					
					let activeLink: Element | null = null;
					tocLinks.forEach(link => {
						const href = link.getAttribute('href');
						if (href === `#${currentActiveId}`) {
							link.classList.add('active');
							link.setAttribute('aria-current', 'location');
							if (link.closest('.post-toc-sidebar')) activeLink = link;
						} else {
							link.classList.remove('active');
							link.removeAttribute('aria-current');
						}
					});
					if (readingStatus) {
						readingStatus.textContent = entry.target.textContent?.replace(/[✓#]$/, '').trim() || '';
						readingStatus.classList.toggle('visible', window.scrollY > 420);
					}
					if (activeLink) {
						const panel = activeLink.closest('.toc-sticky-container') as HTMLElement | null;
						const item = activeLink as HTMLElement;
						if (panel && (item.offsetTop < panel.scrollTop + 70 || item.offsetTop > panel.scrollTop + panel.clientHeight - 50)) {
							panel.scrollTo({ top: Math.max(0, item.offsetTop - 90), behavior: 'smooth' });
						}
					}
				}
			});
		}, observerOptions);

		headingElements.forEach(el => observer.observe(el));
	}
</script>
