---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectFeature from '../components/ProjectFeature.astro';

const rsr = await getEntry('blog', 'rsr-research-retrospective');
---
<Layout title="프로젝트 | 박규태" description="실제 문제를 수학과 통계로 모델링하고 구현한 프로젝트. Yonsei Mileage의 설계와 검증 과정을 소개합니다." isWide={true}>
  <section class="page-header">
    <h1>프로젝트</h1>
    <p class="page-subtitle">실제 질문을 수학적 모델로 옮기고, 구현과 데이터로 그 가정을 확인합니다.</p>
  </section>
  <ProjectFeature />
  {rsr && !rsr.data.draft && (
    <section class="reading-width">
      <h2><a href={`/blog/${rsr.slug}/`}>{rsr.data.title}</a></h2>
      <p>{rsr.data.subtitle}</p>
    </section>
  )}
</Layout>
