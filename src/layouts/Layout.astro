---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/portfolio';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	isWide?: boolean;
	article?: { published: Date; modified?: Date; tags: string[] };
}

const { frontmatter } = Astro.props;

const title = frontmatter?.title || Astro.props.title || "park-gyutae";
const description = frontmatter?.description || Astro.props.description || profile.description;
const image = frontmatter?.image || Astro.props.image || "/og.png";
const isWide = frontmatter?.isWide || Astro.props.isWide || false;

const { article } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://park-gyutae.github.io');
---

<!DOCTYPE html>
<html lang="ko">
	<head>
		<!-- Global Metadata -->
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, canonicalURL)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, canonicalURL)} />

		<link rel="alternate" type="application/rss+xml" title="park-gyutae RSS" href="/rss.xml" />
		{article && <>
			<meta property="article:published_time" content={article.published.toISOString()} />
			<meta property="article:modified_time" content={(article.modified || article.published).toISOString()} />
			{article.tags.map(tag => <meta property="article:tag" content={tag} />)}
			<script type="application/ld+json" set:html={JSON.stringify({
				'@context': 'https://schema.org', '@type': 'BlogPosting',
				headline: title.replace(/ \| park-gyutae$/, ''), description,
				image: new URL(image, canonicalURL).href, url: canonicalURL.href,
				mainEntityOfPage: canonicalURL.href,
				datePublished: article.published.toISOString(),
				dateModified: (article.modified || article.published).toISOString(),
				author: { '@type': 'Person', name: '박규태', url: new URL('/about/', canonicalURL).href },
			}).replace(/</g, '\\u003c')} />
		</>}

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Newsreader:ital,opsz,wght@1,6..72,500&display=swap" rel="stylesheet" />
		<link href="https://spoqa.github.io/spoqa-han-sans/css/SpoqaHanSansNeo.css" rel="stylesheet" type="text/css" />


		<!-- Inline Script to prevent theme flashing -->
		<script is:inline>
			(() => {
				let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				try {
					const saved = localStorage.getItem('theme');
					if (saved === 'light' || saved === 'dark') theme = saved;
				} catch { /* Theme switching still works when storage is unavailable. */ }
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
		<Header />
		<main id="main-content" tabindex="-1" class={isWide ? 'wide-container' : 'container'} style="flex: 1; padding-top: 2rem; padding-bottom: 3rem;">
			{frontmatter ? (
				<div class="prose">
					<slot />
				</div>
			) : (
				<slot />
			)}
		</main>
		<Footer />
	</body>
</html>
