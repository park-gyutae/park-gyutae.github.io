---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/portfolio';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	isWide?: boolean;
	article?: { published: Date; modified?: Date; category?: string; tags: string[] };
}

const { frontmatter } = Astro.props;

const title = frontmatter?.title || Astro.props.title || "park-gyutae";
const description = frontmatter?.description || Astro.props.description || profile.description;
const image = frontmatter?.image || Astro.props.image || "/og.png";
const isWide = frontmatter?.isWide || Astro.props.isWide || false;

const { article } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://park-gyutae.github.io');
---

<!DOCTYPE html>
<html lang="ko">
	<head>
		<!-- Global Metadata -->
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, canonicalURL)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, canonicalURL)} />

		<link rel="alternate" type="application/rss+xml" title="park-gyutae RSS" href="/rss.xml" />
		{article && <>
			<meta property="article:published_time" content={article.published.toISOString()} />
			<meta property="article:modified_time" content={(article.modified || article.published).toISOString()} />
			{article.category && <meta property="article:section" content={article.category} />}
			{article.tags.map(tag => <meta property="article:tag" content={tag} />)}
			<script type="application/ld+json" set:html={JSON.stringify({
				'@context': 'https://schema.org', '@type': article.category ? 'TechArticle' : 'BlogPosting',
				headline: title.replace(/ \| park-gyutae$/, ''), description,
				image: new URL(image, canonicalURL).href, url: canonicalURL.href,
				mainEntityOfPage: canonicalURL.href,
				articleSection: article.category,
				datePublished: article.published.toISOString(),
				dateModified: (article.modified || article.published).toISOString(),
				author: { '@type': 'Person', name: '박규태', url: new URL('/about/', canonicalURL).href },
			}).replace(/</g, '\\u003c')} />
		</>}

		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css" />

		<!-- Inline Script to prevent theme flashing -->
		<script is:inline>
			(() => {
				let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				try {
					const saved = localStorage.getItem('theme');
					if (saved === 'light' || saved === 'dark') theme = saved;
				} catch { /* Theme switching still works when storage is unavailable. */ }
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
		<Header />
		<main id="main-content" tabindex="-1" class={isWide ? 'wide-container' : 'container'}>
			{frontmatter ? (
				<div class="prose">
					<slot />
				</div>
			) : (
				<slot />
			)}
		</main>
		<Footer />
	</body>
</html>

<script>
  // Make overflowing equations discoverable and operable with the keyboard.
  const observer = new ResizeObserver(entries => {
    for (const { target } of entries) {
      const overflows = target.scrollWidth > target.clientWidth;
      if (overflows) {
        target.setAttribute('tabindex', '0');
        target.setAttribute('role', 'region');
        target.setAttribute('aria-label', '가로로 스크롤할 수 있는 수식');
      } else {
        target.removeAttribute('tabindex');
        target.removeAttribute('role');
        target.removeAttribute('aria-label');
      }
    }
  });
  document.querySelectorAll<HTMLElement>('.katex-display').forEach(equation => {
    const hint = document.createElement('span');
    hint.className = 'equation-hint';
    hint.textContent = '가로로 스크롤하여 수식 전체 보기';
    equation.after(hint);
    observer.observe(equation);
  });

  const syncTables = new ResizeObserver(entries => {
    for (const { target } of entries) {
      const region = target.closest('.table-scroll');
      if (!region) continue;
      const canScroll = region.scrollWidth > region.clientWidth;
      if (canScroll) {
        region.setAttribute('tabindex', '0');
        region.setAttribute('role', 'region');
      } else {
        region.removeAttribute('tabindex');
        region.removeAttribute('role');
      }
    }
  });

  document.querySelectorAll('.prose').forEach(prose => {
    let section = '본문';
    prose.querySelectorAll<HTMLElement>('h2, h3, table').forEach(element => {
      if (!(element instanceof HTMLTableElement)) {
        section = element.textContent?.trim().replace(/[#✓]$/, '').trim() || section;
        return;
      }

      const region = document.createElement('div');
      region.className = 'table-scroll';
      const title = element.previousElementSibling;
      if (title?.classList.contains('table-title') && title.id) {
        region.setAttribute('aria-labelledby', title.id);
        element.setAttribute('aria-labelledby', title.id);
      } else {
        const caption = element.caption?.textContent?.trim() || `${section} 표`;
        region.setAttribute('aria-label', caption);
        if (!element.caption) element.setAttribute('aria-label', caption);
      }

      const hint = document.createElement('p');
      hint.className = 'table-scroll-hint';
      hint.textContent = '가로로 스크롤하여 표 전체 보기';
      element.before(hint, region);
      region.append(element);
      syncTables.observe(region);
      syncTables.observe(element);
    });
  });
</script>
