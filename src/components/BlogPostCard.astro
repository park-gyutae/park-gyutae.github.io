---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, pubDate, tags, category } = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <div class="post-entry">
    <div class="card-meta">
      {category ?? <time datetime={pubDate.toISOString()}>{formattedDate}</time>}
    </div>
    <div class="card-content">
      {tags && tags.length > 0 && <p class="meta-category">{tags.slice(0, 2).join(' · ')}</p>}
      <Heading class="card-title"><a href={`/blog/${post.slug}`}>{title}</a></Heading>
      <p class="card-desc">{description}</p>
    </div>
  </div>
</article>

<style>
  .post-card + .post-card { margin-top: 1.4rem; }
  .post-entry { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: .15rem 1rem; align-items: baseline; }
  .card-meta, .meta-category { color: var(--text-muted); font-size: .85rem; }
  .meta-category { margin: 0 0 .25rem; }
  .card-title { font-size: 1.16rem; margin: 0 0 .28rem; }
  .card-desc { margin: 0; }
  @media (max-width: 620px) {
    .post-entry { grid-template-columns: minmax(0, 1fr); }
  }
</style>
