---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <a href={`/blog/${post.slug}`} class="card-link">
    <div class="card-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
    <div class="card-content">
      {tags && tags.length > 0 && <p class="meta-category">{tags.slice(0, 2).join(' · ')}</p>}
      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{description}</p>
    </div>
    <span class="card-arrow" aria-hidden="true">→</span>
  </a>
</article>

<style>
  .post-card {
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--card-bg);
  }
  .post-card:focus-within, .post-card:hover { border-color: var(--primary-color); }
  .card-link {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 1rem;
    padding: clamp(1rem, 3vw, 1.6rem);
    border-radius: inherit;
  }
  .card-meta { color: var(--text-muted); font-size: .8rem; padding-top: .22rem; }
  .meta-category { color: var(--primary-color); font-size: .76rem; font-weight: 700; margin-bottom: .35rem; }
  .card-title { font-size: clamp(1.1rem, 2.4vw, 1.5rem); margin-bottom: .4rem; line-height: 1.35; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .card-desc { color: var(--text-muted); margin: 0; line-height: 1.7; overflow-wrap: anywhere; }
  .card-arrow { color: var(--primary-color); font-size: 1.25rem; }
  @media (max-width: 640px) {
    .card-link { grid-template-columns: minmax(0, 1fr) auto; gap: .55rem .75rem; }
    .card-meta { grid-column: 1 / -1; padding: 0; }
  }
</style>
