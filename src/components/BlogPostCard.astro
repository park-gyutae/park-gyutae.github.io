---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <a href={`/blog/${post.slug}`} class="card-link">
    <div class="card-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
    <div class="card-content">
      {tags && tags.length > 0 && <p class="meta-category">{tags.slice(0, 2).join(' · ')}</p>}
      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{description}</p>
    </div>
    <span class="card-arrow" aria-hidden="true">↗</span>
  </a>
</article>

<style>
  .post-card {
    border-top: 1px solid var(--border-color);
    transition: border-color var(--transition-speed) ease;
  }

  .post-card:hover {
    border-color: var(--primary-color);
  }

  .card-link {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) auto;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
    padding: 2rem 0;
  }

  .card-meta {
    font: 500 0.7rem var(--font-mono);
    color: var(--text-muted);
    padding-top: .3rem;
  }

  .meta-separator {
    color: var(--border-color);
  }

  .meta-category {
    color: var(--primary-color);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    margin-bottom: .55rem;
  }

  .card-title {
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--text-color);
    line-height: 1.45;
    letter-spacing: -.025em;
    transition: color var(--transition-speed) ease;
  }

  .post-card:hover .card-title {
    color: var(--primary-color);
  }

  .card-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-bottom: 0;
    line-height: 1.65;
  }
  .card-arrow { color: var(--text-muted); font-size: 1.3rem; transition: color .2s ease, transform .2s ease; }
  .post-card:hover .card-arrow { color: var(--primary-color); transform: translate(2px, -2px); }
  @media (max-width: 640px) {
    .card-link { grid-template-columns: 1fr auto; gap: .75rem 1rem; }
    .card-meta { grid-column: 1 / -1; padding: 0; }
  }
</style>
